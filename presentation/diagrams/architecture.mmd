graph LR
  subgraph NET["🔗 Shared Network Namespace"]
    subgraph NET_INNER[" "]
      subgraph NET_INNER2[" "]
      subgraph A_GROUP[" "]
        direction TB
        WS["📁 Workspace\n(bind mount)"]
        A["🤖 OpenCode"]
      end

      subgraph GB_GROUP[" "]
        GB["🔀 Git Broker"]
        GBC["🔑 Deploy Key"]
      end

      subgraph MCP_GROUP[" "]
        MCP["🔌 MCP Servers"]
        MCPC["🔑 API Keys"]
      end

      subgraph LLM_GROUP[" "]
        LLMP["🧠 LLM Proxy"]
        LLMPC["🔑 API Keys"]
      end
      end
    end
  end

  subgraph FILTER["🛡️ Network Controls"]
    DNS["🔍 CoreDNS\n(DNS allowlist)"]
    PROXY["🔒 HTTP Proxy\n(allowlist enforced)"]
  end

  A --> GB
  A --> MCP
  A --> LLMP
  A --> DNS
  A --> PROXY
  GB --> DNS
  GB -->|":80 via proxy"| PROXY
  GB -.->|"🔑 SSH :443 (bypasses proxy)"| INET
  MCP --> DNS
  MCP --> PROXY
  LLMP --> DNS
  LLMP --> PROXY
  DNS --> PROXY
  PROXY --> INET["🌍 Internet\n(approved traffic only)"]

